   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace(sum by (week) (batch_blocked), \"week\", \"0$1\", \"week\", `^(\\d)$`)",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace(sum by (week) (batch_contract_warnings), \"week\", \"0$1\", \"week\", `^(\\d)$`)",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "week",
      "mode": "outer"
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "week"
       }
      ]
     }
    },
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "week",
        "destinationType": "number"
       }
      ]
     }
    },
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "pattern": "^(week|Value.*)$"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "min": 0,
     "custom": {
      "drawStyle": "line",
