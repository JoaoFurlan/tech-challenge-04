  {
   "type": "trend",
   "title": "Contract outcome by week",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 8,
