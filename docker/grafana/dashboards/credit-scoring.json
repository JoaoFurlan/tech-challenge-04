     "expr": "label_replace(sum by (week) (drift_mean_psi), \"week\", \"0$1\", \"week\", `^(\\d)$`)",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "week",
      "mode": "outer"
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "week"
       }
      ]
     }
    },
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "pattern": "^(week|Value.*)$"
      }
     }
