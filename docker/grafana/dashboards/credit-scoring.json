  {
   "type": "barchart",
   "title": "Drift severity by week (PSI)",
   "description": "PSI against the champion's training window. The lines mark 0.10 (moderate) and 0.25 (major).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
