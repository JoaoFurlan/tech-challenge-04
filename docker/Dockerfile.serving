# Serving image: multi-stage so uv, its cache and build layers never reach the final image.
# python:3.12-slim (Debian) rather than alpine: musl breaks many scientific wheels.
FROM python:3.12-slim AS build

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-default-groups --group serving --no-editable

FROM python:3.12-slim

WORKDIR /app
COPY --from=build /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn", "credit_drift.serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
